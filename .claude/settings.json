{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Skill(speckit-git-feature)",
      "Skill(code-review)",
      "Skill(reviewloop)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File $CLAUDE_PROJECT_DIR/.claude/scripts/notify.ps1 -Text 'Claude needs your input'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File $CLAUDE_PROJECT_DIR/.claude/scripts/notify.ps1 -Text 'Claude Code finished'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
